# 複製成 .env.local 後填入。.env.local 已在 .gitignore，勿 commit。

# 本機開發：用本地 SQLite 檔，不需要 Turso 帳號
TURSO_DATABASE_URL=file:local.db

# 本機 whitelist seed（逗號分隔 email，寫入時會自動轉為小寫）
DEV_WHITELIST_SESSION=
# BD、Data、Engineering、UIUX、PM、Marketing 擇一
DEV_WHITELIST_GROUP=
DEV_WHITELIST_EMAILS=

# 正式環境改用 Turso，才需要 TURSO_AUTH_TOKEN
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Auth.js — dev only
# AUTH_SECRET 用 `pnpm dlx auth secret` 或 `openssl rand -base64 33` 產生
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth — 從 GCP Console「用戶端」複製
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Firebase Cloud Messaging
# 留空時推播功能整組自動 no-op，不影響其他功能。

# Firebase Web App 設定 — Firebase Console > 專案設定 > 一般 > 你的應用程式
# 這組值不是密鑰，可安全暴露給瀏覽器（保護機制是 Security Rules，不是保密）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push 憑證 — Firebase Console > 專案設定 > Cloud Messaging > Web Push 憑證
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin service account（後端發送推播用）— Firebase Console > 專案設定 >
# 服務帳戶 > 產生新的私密金鑰，下載 JSON 後填入對應欄位
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# JSON 裡的 private_key 是多行字串；貼成單行環境變數時 \n 會被當成字面上的反斜線+n，
# 程式端會自動 unescape（見 src/env.ts），這裡貼原始 JSON 值即可，不用手動處理換行。
FIREBASE_PRIVATE_KEY=
