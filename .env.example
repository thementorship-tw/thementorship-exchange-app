# 複製成 .env.local 後填入。.env.local 已在 .gitignore，勿 commit。

# 本機開發：用本地 SQLite 檔，不需要 Turso 帳號
TURSO_DATABASE_URL=file:local.db

# 測試／正式環境改用 Turso，才需要 TURSO_AUTH_TOKEN
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Auth.js — dev only
# AUTH_SECRET 用 `pnpm dlx auth secret` 或 `openssl rand -base64 33` 產生
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth — 從 GCP Console「用戶端」複製
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
